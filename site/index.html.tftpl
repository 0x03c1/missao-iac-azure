<!doctype html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>${emoji} ${nome} · Servidor #${numero}</title>
<style>
  :root { --cor: ${cor}; }
  * { box-sizing: border-box; }
  body {
    margin: 0; min-height: 100vh; display: grid; place-items: center; padding: 24px;
    font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; color: #fff;
    background: radial-gradient(circle at 30% 20%, rgba(255,255,255,.20), transparent 60%), var(--cor);
  }
  .cartao {
    width: 100%; max-width: 640px; text-align: center; padding: 40px 28px;
    background: rgba(0,0,0,.28); border: 1px solid rgba(255,255,255,.25); border-radius: 24px;
    box-shadow: 0 20px 60px rgba(0,0,0,.35); backdrop-filter: blur(6px);
  }
  .emoji { font-size: 96px; line-height: 1; display: block; animation: flutua 2.4s ease-in-out infinite; }
  @keyframes flutua {
    0%, 100% { transform: translateY(0) rotate(-4deg); }
    50% { transform: translateY(-14px) rotate(4deg); }
  }
  .selo {
    display: inline-block; margin-top: 20px; padding: 6px 12px; border-radius: 999px;
    font-size: 13px; letter-spacing: .08em; text-transform: uppercase; background: rgba(255,255,255,.18);
  }
  h1 { font-size: clamp(28px, 6vw, 44px); margin: 12px 0 8px; }
  .lema { font-size: 20px; font-style: italic; opacity: .92; margin: 0 0 28px; }
  .info { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 12px; text-align: left; }
  .info div { background: rgba(255,255,255,.12); border-radius: 14px; padding: 12px 14px; }
  .info small { display: block; font-size: 12px; opacity: .75; text-transform: uppercase; letter-spacing: .06em; }
  .info strong { font-size: 16px; }
  footer { margin-top: 24px; font-size: 13px; opacity: .8; }
</style>
</head>
<body>
  <main class="cartao">
    <div class="emoji">${emoji}</div>
    <div class="selo">Servidor #${numero} · no ar ✅</div>
    <h1>${nome}</h1>
    <p class="lema">“${lema}”</p>
    <section class="info">
      <div><small>Região Azure</small><strong>${regiao}</strong></div>
      <div><small>Criado por</small><strong>Terraform</strong></div>
      <div><small>Cliques no portal</small><strong>0 🙌</strong></div>
    </section>
    <footer>Infraestrutura como Código · Faculdade Senac · Análise e Desenvolvimento de Sistemas</footer>
  </main>
</body>
</html>
